
<config check="d9c6b83b5a54bd453effb61a1ee715c9">
	<snippets base="conf/snippets/">
		<!-- Snippets are below, because Panfu is using an outdated way to load snippets when put in here -->
	</snippets>
	
	<file path="contemporary/snippets_$$lang$$.xml" id="contemporary" attributesInSnippetName="type_id"/>
	<file path="local/snippets_$$lang$$.xml" id="local" attributesInSnippetName="type_room_group_id"/>
	<file path="global/snippets_$$lang$$.xml" id="global" attributesInSnippetName="type_group_id"/>		
	
	<timer interval="390000" varianz="420000"/>

	<assets>
		<asset id="SpeechBubbleNavControls" path="assets/SpeechBubbleNavControls.swf"/>
		<asset id="ACActivationControls" path="assets/ACActivationControls.swf"/>
		<asset id="on#1" path="assets/states/state_on_1.swf"/>
		<asset id="off#1" path="assets/states/state_off_1.swf"/>
		<asset id="talking#1" path="assets/states/state_talking_1.swf"/>
		<asset id="talking#2" path="assets/states/state_talking_2.swf"/>
		<asset id="talking#3" path="assets/states/state_talking_3.swf"/>
		<asset id="default#1" path="assets/states/state_default.swf"/>
		<asset id="zero#1" path="assets/states/state_zero_1.swf"/>
		<asset id="idling#1" path="assets/states/state_idling_1.swf"/>
		<asset id="idling#2" path="assets/states/state_idling_2.swf"/>
		<asset id="idling#3" path="assets/states/state_idling_3.swf"/>
		<asset id="idling#4" path="assets/states/state_idling_4.swf"/>
		<asset id="idling#5" path="assets/states/state_idling_5.swf"/>
	</assets>
	
	<sounds>
	     <sound id="SpeechBubbleChatter" volume="0.5" path="audio/cute_ac.mp3" loops="0"/>    
	</sounds>
	
	<module>
		<animations>
			<zeroInterruptTimer interval="15000" varianz=""/>
			<preloads>
				<group id="1">
					<preload id="off#1"/>
					<preload id="zero#1"/>
					<preload id="on#1"/>
				</group>
				<group id="2">
					<preload id="talking#1"/>
					<preload id="talking#2" />
					<preload id="talking#3" />
					<preload id="idling#1"/>
					<preload id="idling#2" />
					<preload id="idling#3" />
					<preload id="idling#4" />
					<preload id="idling#5" />
				</group>
			</preloads>
		</animations>
	</module>
</config>