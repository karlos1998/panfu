          <target value="levelup_positive" date="levelup_51" gamestate="5,0,10"/>
          <target value="levelup_negative_alreadytoday" date="levelup_52" daypasstest="5,0,0"/>
          <target value="levelup_positive" date="levelup_52" gamestate="5,0,20" daypasstest="5,0,1,+"/>
          <target value="levelup_positive" date="levelup_52" gamestate="5,0,10"/>
        </checks>
      </hotspot>
    </hotspots>
    <actions>
      <action id="levelup_positive">
        <onLevelBoost/>
        <startLevelBoost/>
        <handleAnimation path="elements/laser/laser" com="play" frame="3"/>
        <handleAnimation path="elements/brainmachine/brainmachine" com="play" frame="3"/>
        <handleAnimation path="elements/computer/computer" com="play" frame="levelup"/>
        <stopAvatar/>
        <blockScreen block="1"/>
