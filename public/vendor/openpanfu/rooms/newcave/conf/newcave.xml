      <action id="levelup_negative_wrongday">
        <onLevelBoost/>
        <playSound id="levelup_negative"/>
      </action>
      <action id="levelup_negative_alreadytoday">
        <onLevelBoost/>
        <playSound id="levelup_negative"/>
      </action>
      <action id="laserFinished">
        <levelboost/>
        <blockScreen block="0"/>
        <showAvatar vis="1"/>
      </action>
      <action id="lasersound">
        <playSound id="levelup_positive"/>
      </action>
      <action id="lasersoundOver">
        <stopSound id="levelup_positive"/>
      </action>
    </actions>
  </module>
